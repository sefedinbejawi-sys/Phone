rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jimielbejawi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\-]+$');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Public catalog; only the owner/admin can mutate inventory.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Visitors may submit COD orders, but customer records are private to admins.
    match /orders/{orderId} {
      allow create: if isValidId(orderId) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 150 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30;
      allow read, update, delete: if isAdmin();
    }

    // Visitors may submit repair requests; only admins can inspect/update tickets.
    match /repairs/{repairId} {
      allow create: if isValidId(repairId) &&
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30;
      allow read, update, delete: if isAdmin();
    }

    // Installment applications can be submitted by visitors; plans are private.
    match /installments/{installmentId} {
      allow create: if isValidId(installmentId) &&
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30;
      allow read, update, delete: if isAdmin();
    }

    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
