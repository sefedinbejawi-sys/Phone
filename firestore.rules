rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jimielbejawi@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow create: if isValidId(orderId) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 150 &&
        request.resource.data.customerPhone is string &&
        request.resource.data.customerPhone.size() <= 30;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Repairs Collection
    match /repairs/{repairId} {
      allow create: if isValidId(repairId) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() <= 150 &&
        request.resource.data.customerPhone is string &&
        request.resource.data.customerPhone.size() <= 30;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // Installments Collection
    match /installments/{installmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
