{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Smartphones, tablets, and accessories in Hamtine Telecom 4 catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nameFr": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "color": { "type": "string" },
        "colorHex": { "type": "string" },
        "condition": { "type": "string" },
        "warrantyMonths": { "type": "number" },
        "stock": { "type": "number" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "descriptionFr": { "type": "string" },
        "allowInstallment": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "name", "brand", "price", "stock", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order, including delivery or in-store pickup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deliveryType": { "type": "string" },
        "wilayaCode": { "type": "number" },
        "wilayaName": { "type": "string" },
        "commune": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "subtotal": { "type": "number" },
        "shippingCost": { "type": "number" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "isInstallment": { "type": "boolean" }
      },
      "required": ["id", "customerName", "customerPhone", "totalAmount", "status"]
    },
    "RepairTicket": {
      "title": "RepairTicket",
      "description": "Hardware and software maintenance service ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "deviceModel": { "type": "string" },
        "issueType": { "type": "string" },
        "issueDescription": { "type": "string" },
        "estimatedCost": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "deviceModel", "status"]
    },
    "InstallmentPlan": {
      "title": "InstallmentPlan",
      "description": "Customer installment financing agreement and payment schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "planNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "nationalId": { "type": "string" },
        "totalAmount": { "type": "number" },
        "downPayment": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "monthsCount": { "type": "number" },
        "monthlyPayment": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "totalAmount", "monthsCount"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store inventory of smartphones, tablets, and accessories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders for store pickup and delivery"
    },
    "/repairs/{repairId}": {
      "schema": "RepairTicket",
      "description": "Repair tickets for phone maintenance workshop"
    },
    "/installments/{installmentId}": {
      "schema": "InstallmentPlan",
      "description": "Installment financing agreements and monthly schedules"
    }
  }
}
